<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,user-scalable=no">
<title>Ninja Runner</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#0b0b12;height:100vh;display:flex;justify-content:center;align-items:center;overflow:hidden;font-family:Arial,sans-serif}
#gameBox{position:relative;width:400px;height:700px;max-width:100vw;max-height:100vh;overflow:hidden;border-radius:18px;box-shadow:0 0 30px #000}
canvas{width:100%;height:100%;display:block;touch-action:none}
#hud{position:absolute;top:12px;left:10px;right:10px;display:flex;justify-content:space-between;z-index:5}
.info{background:rgba(0,0,0,.58);color:#fff;padding:8px 12px;border-radius:12px;font-weight:bold;text-shadow:1px 1px 2px #000}
#start,#gameOver{position:absolute;inset:0;background:rgba(0,0,0,.76);color:#fff;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;z-index:10}
#gameOver{display:none}
h1{font-size:42px;margin:10px;text-shadow:0 0 15px #ff1744}
p{line-height:1.5}
button{border:0;border-radius:12px;padding:14px 30px;background:#e91e63;color:#fff;font-size:20px;font-weight:bold;cursor:pointer}
</style>
</head>
<body>
<div id="gameBox">
<canvas id="game" width="400" height="700"></canvas>

<div id="hud">
  <div class="info">🏆 Score: <span id="score">0</span></div>
  <div class="info">🪙 Coins: <span id="coins">0</span></div>
  <div class="info">⚡ <span id="speed">6</span></div>
</div>

<div id="start">
  <h1>🥷 NINJA RUNNER</h1>
  <p>Tap / Space / ↑ to jump<br>Collect coins and avoid obstacles</p>
  <button id="play">PLAY</button>
</div>

<div id="gameOver">
  <h1>GAME OVER</h1>
  <p>Score: <b id="finalScore">0</b></p>
  <p>Coins: <b id="finalCoins">0</b></p>
  <button onclick="location.reload()">PLAY AGAIN</button>
</div>
</div>

<script>
const canvas=document.getElementById("game");
const ctx=canvas.getContext("2d");

const ninja={
  x:60,y:540,w:48,h:78,vy:0,jumping:false
};

const ground=615;
let obstacles=[],coinsList=[];
let score=0,coins=0,speed=6;
let running=false,dead=false;
let spawnObstacleTimer=0,spawnCoinTimer=0,last=0;

function roundedRect(x,y,w,h,r){
  ctx.beginPath();
  ctx.moveTo(x+r,y);
  ctx.arcTo(x+w,y,x+w,y+h,r);
  ctx.arcTo(x+w,y+h,x,y+h,r);
  ctx.arcTo(x,y+h,x,y,r);
  ctx.arcTo(x,y,x+w,y,r);
  ctx.closePath();
}

function startGame(){
  document.getElementById("start").style.display="none";
  running=true;
  last=performance.now();
  requestAnimationFrame(loop);
}

document.getElementById("play").onclick=startGame;

function jump(){
  if(!running || dead)return;
  if(!ninja.jumping){
    ninja.vy=-15;
    ninja.jumping=true;
  }
}

document.addEventListener("keydown",e=>{
  if(e.code==="Space" || e.key==="ArrowUp") jump();
});

canvas.addEventListener("touchstart",()=>jump(),{passive:true});

/* Background */
function drawBackground(dt){
  ctx.fillStyle="#111528";
  ctx.fillRect(0,0,400,700);

  /* moon */
  ctx.fillStyle="#fff1b8";
  ctx.beginPath();
  ctx.arc(310,100,45,0,Math.PI*2);
  ctx.fill();

  /* stars */
  ctx.fillStyle="#fff";
  for(let i=0;i<30;i++){
    const x=(i*83)%400;
    const y=(i*47)%320;
    ctx.fillRect(x,y,2,2);
  }

  /* distant mountains */
  ctx.fillStyle="#1e2140";
  ctx.beginPath();
  ctx.moveTo(0,455);
  ctx.lineTo(75,330);
  ctx.lineTo(150,455);
  ctx.lineTo(235,295);
  ctx.lineTo(330,455);
  ctx.lineTo(400,350);
  ctx.lineTo(400,700);
  ctx.lineTo(0,700);
  ctx.closePath();
  ctx.fill();

  /* ground */
  ctx.fillStyle="#292929";
  ctx.fillRect(0,ground,400,85);

  /* moving ground marks */
  ctx.fillStyle="#3e3e3e";
  const off=(performance.now()/8)%60;
  for(let y=ground+off;y<700;y+=60){
    ctx.fillRect(0,y,400,4);
  }

  ctx.fillStyle="#e91e63";
  ctx.fillRect(0,ground,400,5);
}

/* Better animated ninja */
function drawNinja(){
  ctx.save();

  const t=performance.now()/100;
  const run=Math.sin(t)*8;
  const arm=Math.sin(t)*10;
  const jumpPose=ninja.jumping;

  /* shadow */
  ctx.fillStyle="rgba(0,0,0,.38)";
  ctx.beginPath();
  ctx.ellipse(
    ninja.x+24,ground+3,
    jumpPose?18:28,6,0,0,Math.PI*2
  );
  ctx.fill();

  /* scarf */
  ctx.fillStyle="#e91e63";
  ctx.beginPath();
  ctx.moveTo(ninja.x+12,ninja.y+15);
  ctx.quadraticCurveTo(
    ninja.x-8,ninja.y+4+arm,
    ninja.x-22,ninja.y+10+arm
  );
  ctx.lineTo(ninja.x+4,ninja.y+29);
  ctx.closePath();
  ctx.fill();

  /* back leg */
  ctx.strokeStyle="#101010";
  ctx.lineWidth=10;
  ctx.lineCap="round";
  ctx.beginPath();
  ctx.moveTo(ninja.x+19,ninja.y+55);
  ctx.lineTo(
    ninja.x+10+(jumpPose?0:run),
    ninja.y+75
  );
  ctx.stroke();

  /* front leg */
  ctx.beginPath();
  ctx.moveTo(ninja.x+29,ninja.y+55);
  ctx.lineTo(
    ninja.x+39-(jumpPose?0:run),
    ninja.y+75
  );
  ctx.stroke();

  /* shoes */
  ctx.strokeStyle="#e91e63";
  ctx.lineWidth=6;

  ctx.beginPath();
  ctx.moveTo(ninja.x+5+(jumpPose?0:run),ninja.y+75);
  ctx.lineTo(ninja.x-3+(jumpPose?0:run),ninja.y+75);
  ctx.stroke();

  ctx.beginPath();
  ctx.moveTo(ninja.x+40-(jumpPose?0:run),ninja.y+75);
  ctx.lineTo(ninja.x+49-(jumpPose?0:run),ninja.y+75);
  ctx.stroke();

  /* body */
  ctx.fillStyle="#101010";
  roundedRect(ninja.x+9,ninja.y+25,31,36,8);
  ctx.fill();

  /* chest armor */
  ctx.fillStyle="#292929";
  roundedRect(ninja.x+13,ninja.y+29,23,27,5);
  ctx.fill();

  /* belt */
  ctx.fillStyle="#e91e63";
  ctx.fillRect(ninja.x+9,ninja.y+52,31,5);

  /* back arm */
  ctx.strokeStyle="#111";
  ctx.lineWidth=9;
  ctx.beginPath();
  ctx.moveTo(ninja.x+12,ninja.y+32);
  ctx.lineTo(
    ninja.x+2-(jumpPose?0:arm),
    ninja.y+50
  );
  ctx.stroke();

  /* front arm */
  ctx.beginPath();
  ctx.moveTo(ninja.x+37,ninja.y+32);
  ctx.lineTo(
    ninja.x+48+(jumpPose?0:arm),
    ninja.y+45
  );
  ctx.stroke();

  /* hands */
  ctx.fillStyle="#c9875c";
  ctx.beginPath();
  ctx.arc(
    ninja.x+2-(jumpPose?0:arm),
    ninja.y+50,5,0,Math.PI*2
  );
  ctx.fill();

  ctx.beginPath();
  ctx.arc(
    ninja.x+48+(jumpPose?0:arm),
    ninja.y+45,5,0,Math.PI*2
  );
  ctx.fill();

  /* head */
  ctx.fillStyle="#111";
  ctx.beginPath();
  ctx.arc(ninja.x+25,ninja.y+17,19,0,Math.PI*2);
  ctx.fill();

  /* face */
  ctx.fillStyle="#c9875c";
  ctx.fillRect(ninja.x+10,ninja.y+12,30,12);

  /* head band */
  ctx.fillStyle="#e91e63";
  ctx.fillRect(ninja.x+7,ninja.y+5,36,8);

  /* eyes */
  ctx.fillStyle="#fff";
  ctx.fillRect(ninja.x+17,ninja.y+14,6,4);
  ctx.fillRect(ninja.x+28,ninja.y+14,6,4);

  ctx.fillStyle="#111";
  ctx.fillRect(ninja.x+20,ninja.y+15,2,2);
  ctx.fillRect(ninja.x+31,ninja.y+15,2,2);

  /* sword */
  ctx.save();
  ctx.translate(ninja.x+39,ninja.y+36);
  ctx.rotate(-0.55+Math.sin(t)*0.04);

  ctx.strokeStyle="#8d6e63";
  ctx.lineWidth=5;
  ctx.beginPath();
  ctx.moveTo(0,10);
  ctx.lineTo(0,31);
  ctx.stroke();

  ctx.strokeStyle="#e8f5ff";
  ctx.lineWidth=5;
  ctx.beginPath();
  ctx.moveTo(0,10);
  ctx.lineTo(5,-27);
  ctx.stroke();

  ctx.restore();
  ctx.restore();
}

/* Obstacles */
function spawnObstacle(){
  obstacles.push({
    x:420,
    y:ground-46,
    w:38,
    h:46
  });
}

function drawObstacles(dt){
  for(const o of obstacles){
    o.x-=speed*dt/16.67;

    ctx.fillStyle="#7b1fa2";
    roundedRect(o.x,o.y,o.w,o.h,6);
    ctx.fill();

    ctx.fillStyle="#e1bee7";
    ctx.fillRect(o.x+8,o.y+8,22,7);

    ctx.fillStyle="#4a145f";
    ctx.fillRect(o.x+7,o.y+25,24,6);
  }
}

/* Coins */
function spawnCoin(){
  coinsList.push({
    x:420,
    y:410+Math.random()*120,
    r:11,
    rot:0
  });
}

function drawCoins(dt){
  for(const c of coinsList){
    c.x-=speed*dt/16.67;
    c.rot+=0.12;

    ctx.save();
    ctx.translate(c.x,c.y);
    ctx.scale(.45+Math.abs(Math.cos(c.rot))*.55,1);

    ctx.fillStyle="#ffd600";
    ctx.beginPath();
    ctx.arc(0,0,c.r,0,Math.PI*2);
    ctx.fill();

    ctx.strokeStyle="#fff59d";
    ctx.lineWidth=2;
    ctx.stroke();

    ctx.fillStyle="#8d6e00";
    ctx.font="bold 14px Arial";
    ctx.textAlign="center";
    ctx.textBaseline="middle";
    ctx.fillText("$",0,1);

    ctx.restore();
  }
}

/* Physics */
function updateNinja(dt){
  ninja.vy+=0.8*dt/16.67;
  ninja.y+=ninja.vy*dt/16.67;

  if(ninja.y+ninja.h>=ground){
    ninja.y=ground-ninja.h;
    ninja.vy=0;
    ninja.jumping=false;
  }
}

/* Collision */
function collision(){
  for(const o of obstacles){
    if(
      ninja.x+38>o.x &&
      ninja.x+8<o.x+o.w &&
      ninja.y+ninja.h-5>o.y &&
      ninja.y+10<o.y+o.h
    ){
      endGame();
      return;
    }
  }

  for(let i=coinsList.length-1;i>=0;i--){
    const c=coinsList[i];

    if(
      ninja.x<c.x+c.r &&
      ninja.x+ninja.w>c.x-c.r &&
      ninja.y<c.y+c.r &&
      ninja.y+ninja.h>c.y-c.r
    ){
      coins++;
      score+=5;
      coinsList.splice(i,1);
    }
  }
}

/* End game */
function endGame(){
  if(dead)return;
  dead=true;
  running=false;

  document.getElementById("finalScore").textContent=Math.floor(score);
  document.getElementById("finalCoins").textContent=coins;
  document.getElementById("gameOver").style.display="flex";
}

/* Main loop */
function loop(now){
  if(!running)return;

  const dt=Math.min(32,now-last);
  last=now;

  ctx.clearRect(0,0,400,700);

  drawBackground(dt);

  updateNinja(dt);

  spawnObstacleTimer+=dt;
  spawnCoinTimer+=dt;

  if(spawnObstacleTimer>1250){
    spawnObstacleTimer=0;
    spawnObstacle();
  }

  if(spawnCoinTimer>850){
    spawnCoinTimer=0;
    spawnCoin();
  }

  speed=Math.min(12,6+Math.floor(score/120));

  drawObstacles(dt);
  drawCoins(dt);
  drawNinja();

  collision();

  obstacles=obstacles.filter(o=>o.x>-70);
  coinsList=coinsList.filter(c=>c.x>-30);

  score+=0.03;

  document.getElementById("score").textContent=Math.floor(score);
  document.getElementById("coins").textContent=coins;
  document.getElementById("speed").textContent=Math.floor(speed);

  if(!dead)requestAnimationFrame(loop);
}
</script>
</body>
</html>