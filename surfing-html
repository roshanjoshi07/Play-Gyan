<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>🏄 Surf Wave</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    user-select:none;
    -webkit-user-select:none;
}

body{
    overflow:hidden;
    background:#061b2b;
    font-family:Arial,sans-serif;
}

canvas{
    display:block;
    width:100vw;
    height:100vh;
    touch-action:none;
}

/* HUD */

#hud{
    position:fixed;
    top:15px;
    left:15px;
    right:15px;
    z-index:10;

    display:flex;
    justify-content:space-between;
    align-items:center;

    color:white;
    font-size:17px;
    font-weight:bold;

    text-shadow:
        0 2px 5px #000;
}

/* Controls */

#controls{
    position:fixed;
    bottom:22px;
    left:0;
    right:0;

    z-index:20;

    display:flex;
    justify-content:center;
    gap:14px;
}

.control{
    width:68px;
    height:68px;

    border:2px solid #ffffff55;
    border-radius:50%;

    background:#ffffff22;
    color:white;

    font-size:26px;

    backdrop-filter:blur(8px);

    box-shadow:
        0 5px 20px #0005;

    touch-action:none;
}

.control:active{
    transform:scale(.9);
    background:#00b4d899;
}

#jump{
    background:#0096c755;
}

/* Game Over */

#gameOver{
    position:fixed;
    inset:0;

    z-index:50;

    display:none;
    align-items:center;
    justify-content:center;

    background:#000b;
}

#gameOver.show{
    display:flex;
}

.panel{
    width:min(400px,90%);

    padding:35px;

    text-align:center;

    color:white;

    border-radius:25px;

    background:
        linear-gradient(
            145deg,
            #092333,
            #03111c
        );

    box-shadow:
        0 20px 70px #000;
}

.panel h1{
    font-size:42px;
    margin-bottom:15px;
}

.panel h2{
    font-size:35px;
    margin-top:8px;
}

#restart{
    margin-top:22px;

    padding:14px 35px;

    border:0;
    border-radius:30px;

    background:#00b4d8;
    color:white;

    font-weight:bold;
    font-size:16px;

    cursor:pointer;
}

#restart:active{
    transform:scale(.95);
}
</style>
</head>

<body>

<canvas id="game"></canvas>


<!-- HUD -->

<div id="hud">

    <div>
        🏄 SURF WAVE
    </div>

    <div>
        ⭐ <span id="score">0</span>
    </div>

    <div>
        🪙 <span id="coins">0</span>
    </div>

</div>


<!-- MOBILE CONTROLS -->

<div id="controls">

    <button
        class="control"
        id="left">
        ◀
    </button>

    <button
        class="control"
        id="jump">
        ▲
    </button>

    <button
        class="control"
        id="right">
        ▶
    </button>

</div>


<!-- GAME OVER -->

<div id="gameOver">

    <div class="panel">

        <h1>
            🌊 WIPEOUT!
        </h1>

        <p>
            Final Score
        </p>

        <h2 id="finalScore">
            0
        </h2>

        <button id="restart">
            PLAY AGAIN
        </button>

    </div>

</div>


<script>

/* =====================================================
   CANVAS
===================================================== */

const canvas =
document.getElementById("game");

const ctx =
canvas.getContext("2d");

let W;
let H;

function resize(){

    W =
    canvas.width =
    innerWidth;

    H =
    canvas.height =
    innerHeight;
}

resize();

addEventListener(
    "resize",
    resize
);


/* =====================================================
   GAME VARIABLES
===================================================== */

let running = true;

let score = 0;

let coins = 0;

let speed = 5;

let spawnTimer = 0;

let coinTimer = 0;


/* =====================================================
   PLAYER
===================================================== */

const player = {

    x:0,

    y:0,

    width:58,

    height:90,

    vy:0,

    jumping:false,

    anim:0
};


/* =====================================================
   OBJECTS
===================================================== */

let obstacles = [];

let coinList = [];


/* =====================================================
   INPUT
===================================================== */

const keys = {

    left:false,

    right:false

};


/* =====================================================
   MOBILE BUTTON
===================================================== */

function holdButton(
    element,
    key
){

    element.addEventListener(
        "pointerdown",
        e=>{

            e.preventDefault();

            keys[key] = true;

        }
    );

    element.addEventListener(
        "pointerup",
        e=>{

            e.preventDefault();

            keys[key] = false;

        }
    );

    element.addEventListener(
        "pointercancel",
        ()=>{

            keys[key] = false;

        }
    );

    element.addEventListener(
        "pointerleave",
        ()=>{

            keys[key] = false;

        }
    );
}


holdButton(
    document.getElementById("left"),
    "left"
);


holdButton(
    document.getElementById("right"),
    "right"
);


/* =====================================================
   JUMP
===================================================== */

function jump(){

    if(
        !player.jumping &&
        running
    ){

        player.vy = -14;

        player.jumping = true;

        beep(
            650,
            .08
        );
    }
}


document
.getElementById("jump")
.addEventListener(
    "pointerdown",
    jump
);


/* =====================================================
   KEYBOARD
===================================================== */

addEventListener(
    "keydown",
    e=>{

        if(
            e.key === "ArrowLeft" ||
            e.key.toLowerCase() === "a"
        ){

            keys.left = true;

        }


        if(
            e.key === "ArrowRight" ||
            e.key.toLowerCase() === "d"
        ){

            keys.right = true;

        }


        if(
            e.key === "ArrowUp" ||
            e.key === " "
        ){

            jump();

        }

    }
);


addEventListener(
    "keyup",
    e=>{

        if(
            e.key === "ArrowLeft" ||
            e.key.toLowerCase() === "a"
        ){

            keys.left = false;

        }


        if(
            e.key === "ArrowRight" ||
            e.key.toLowerCase() === "d"
        ){

            keys.right = false;

        }

    }
);


/* =====================================================
   SOUND SYSTEM
===================================================== */

let audioCtx = null;


function beep(
    frequency,
    duration
){

    try{

        if(!audioCtx){

            audioCtx =
            new (
                window.AudioContext ||
                window.webkitAudioContext
            )();

        }


        if(
            audioCtx.state ===
            "suspended"
        ){

            audioCtx.resume();

        }


        const osc =
        audioCtx.createOscillator();

        const gain =
        audioCtx.createGain();


        osc.type =
        "sine";

        osc.frequency.value =
        frequency;


        gain.gain.value =
        .05;


        osc.connect(gain);

        gain.connect(
            audioCtx.destination
        );


        osc.start();


        osc.stop(
            audioCtx.currentTime +
            duration
        );

    }
    catch(error){

        console.log(error);

    }

}


/* =====================================================
   OCEAN
===================================================== */

function drawOcean(){

    const gradient =
    ctx.createLinearGradient(
        0,
        0,
        0,
        H
    );


    gradient.addColorStop(
        0,
        "#48cae4"
    );

    gradient.addColorStop(
        .45,
        "#0077b6"
    );

    gradient.addColorStop(
        1,
        "#023e8a"
    );


    ctx.fillStyle =
    gradient;


    ctx.fillRect(
        0,
        0,
        W,
        H
    );


    /* SUN */

    ctx.fillStyle =
    "#ffffff35";


    ctx.beginPath();

    ctx.arc(
        W*.82,
        H*.15,
        65,
        0,
        Math.PI*2
    );

    ctx.fill();


    /* WAVES */

    for(
        let y=H*.36;
        y<H;
        y+=75
    ){

        ctx.beginPath();


        for(
            let x=0;
            x<=W;
            x+=20
        ){

            const wave =
            Math.sin(
                x*.018 +
                performance.now()*.0015 +
                y
            ) * 12;


            if(
                x === 0
            ){

                ctx.moveTo(
                    x,
                    y + wave
                );

            }
            else{

                ctx.lineTo(
                    x,
                    y + wave
                );

            }

        }


        ctx.strokeStyle =
        "#ffffff38";

        ctx.lineWidth = 3;

        ctx.stroke();

    }

}


/* =====================================================
   HORIZON
===================================================== */

function drawHorizon(){

    ctx.fillStyle =
    "#ffd166";


    ctx.fillRect(
        0,
        H*.28,
        W,
        12
    );


    /* PALM TREE */

    ctx.strokeStyle =
    "#513c25";

    ctx.lineWidth = 10;


    ctx.beginPath();

    ctx.moveTo(
        W*.12,
        H*.28
    );

    ctx.lineTo(
        W*.09,
        H*.08
    );

    ctx.stroke();


    ctx.strokeStyle =
    "#2a9d55";

    ctx.lineWidth = 8;


    for(
        let i=0;
        i<5;
        i++
    ){

        ctx.beginPath();

        ctx.moveTo(
            W*.09,
            H*.1
        );

        ctx.lineTo(
            W*.09 +
            Math.cos(i*1.2)*50,
            H*.1 -
            Math.abs(
                Math.sin(i*1.2)
            )*35
        );

        ctx.stroke();

    }

}


/* =====================================================
   SURFER CHARACTER
===================================================== */

function drawPlayer(){

    const ground =
    H*.72;


    const py =
    ground -
    player.height -
    player.y;


    player.anim += .12;


    ctx.save();


    ctx.translate(
        player.x,
        py
    );


    /*
       SMALL BOBBING
    */

    const bob =
    Math.sin(
        player.anim
    ) * 2;


    ctx.translate(
        0,
        bob
    );


    /* =================================================
       SHADOW
    ================================================= */

    ctx.fillStyle =
    "rgba(0,0,0,.25)";


    ctx.beginPath();

    ctx.ellipse(
        0,
        88,
        48,
        9,
        0,
        0,
        Math.PI*2
    );

    ctx.fill();


    /* =================================================
       SURFBOARD
    ================================================= */

    const boardGradient =
    ctx.createLinearGradient(
        -60,
        0,
        60,
        0
    );


    boardGradient.addColorStop(
        0,
        "#ff4d6d"
    );

    boardGradient.addColorStop(
        .5,
        "#ffd166"
    );

    boardGradient.addColorStop(
        1,
        "#00b4d8"
    );


    ctx.fillStyle =
    boardGradient;


    ctx.beginPath();

    ctx.moveTo(
        -58,
        78
    );

    ctx.quadraticCurveTo(
        -25,
        65,
        0,
        68
    );

    ctx.quadraticCurveTo(
        30,
        65,
        58,
        78
    );

    ctx.quadraticCurveTo(
        30,
        91,
        0,
        93
    );

    ctx.quadraticCurveTo(
        -30,
        91,
        -58,
        78
    );

    ctx.closePath();

    ctx.fill();


    /* BOARD LINE */

    ctx.strokeStyle =
    "#ffffffcc";

    ctx.lineWidth = 3;


    ctx.beginPath();

    ctx.moveTo(
        -35,
        78
    );

    ctx.lineTo(
        35,
        78
    );

    ctx.stroke();


    /* =================================================
       LEGS
    ================================================= */

    ctx.lineCap =
    "round";


    ctx.strokeStyle =
    "#c77b58";

    ctx.lineWidth = 11;


    ctx.beginPath();

    ctx.moveTo(
        -8,
        49
    );

    ctx.lineTo(
        -25,
        72
    );

    ctx.stroke();


    ctx.beginPath();

    ctx.moveTo(
        9,
        49
    );

    ctx.lineTo(
        27,
        70
    );

    ctx.stroke();


    /* FEET */

    ctx.strokeStyle =
    "#f2a65a";

    ctx.lineWidth = 8;


    ctx.beginPath();

    ctx.moveTo(
        -25,
        72
    );

    ctx.lineTo(
        -34,
        76
    );


    ctx.moveTo(
        27,
        70
    );

    ctx.lineTo(
        36,
        73
    );

    ctx.stroke();


    /* =================================================
       SHORTS
    ================================================= */

    const shorts =
    ctx.createLinearGradient(
        -20,
        35,
        20,
        55
    );


    shorts.addColorStop(
        0,
        "#073b4c"
    );

    shorts.addColorStop(
        1,
        "#118ab2"
    );


    ctx.fillStyle =
    shorts;


    ctx.beginPath();

    ctx.roundRect(
        -19,
        35,
        38,
        22,
        7
    );

    ctx.fill();


    /* =================================================
       SHIRT
    ================================================= */

    const shirt =
    ctx.createLinearGradient(
        -20,
        10,
        20,
        50
    );


    shirt.addColorStop(
        0,
        "#06d6a0"
    );

    shirt.addColorStop(
        1,
        "#118ab2"
    );


    ctx.fillStyle =
    shirt;


    ctx.beginPath();

    ctx.roundRect(
        -18,
        8,
        36,
        36,
        9
    );

    ctx.fill();


    /* SHIRT LOGO */

    ctx.fillStyle =
    "#ffffff";

    ctx.font =
    "bold 10px Arial";

    ctx.textAlign =
    "center";


    ctx.fillText(
        "SURF",
        0,
        31
    );


    /* =================================================
       LEFT ARM
    ================================================= */

    ctx.strokeStyle =
    "#c77b58";

    ctx.lineWidth = 10;


    ctx.beginPath();

    ctx.moveTo(
        -15,
        15
    );

    ctx.quadraticCurveTo(
        -37,
        25,
        -45,
        45
    );

    ctx.stroke();


    /* RIGHT ARM */

    ctx.beginPath();

    ctx.moveTo(
        15,
        15
    );

    ctx.quadraticCurveTo(
        38,
        25,
        47,
        43
    );

    ctx.stroke();


    /* HANDS */

    ctx.fillStyle =
    "#d8906a";


    ctx.beginPath();

    ctx.arc(
        -45,
        45,
        6,
        0,
        Math.PI*2
    );


    ctx.arc(
        47,
        43,
        6,
        0,
        Math.PI*2
    );


    ctx.fill();


    /* =================================================
       NECK
    ================================================= */

    ctx.fillStyle =
    "#c77b58";


    ctx.fillRect(
        -8,
        0,
        16,
        13
    );


    /* =================================================
       FACE
    ================================================= */

    const skin =
    ctx.createRadialGradient(
        -5,
        -8,
        2,
        0,
        0,
        23
    );


    skin.addColorStop(
        0,
        "#ffd1b3"
    );

    skin.addColorStop(
        .7,
        "#d9906a"
    );

    skin.addColorStop(
        1,
        "#a85f45"
    );


    ctx.fillStyle =
    skin;


    ctx.beginPath();

    ctx.arc(
        0,
        -10,
        21,
        0,
        Math.PI*2
    );

    ctx.fill();


    /* =================================================
       HAIR
    ================================================= */

    ctx.fillStyle =
    "#17202a";


    ctx.beginPath();

    ctx.arc(
        0,
        -15,
        22,
        Math.PI,
        Math.PI*2
    );

    ctx.fill();


    /* HAIR SPIKES */

    ctx.beginPath();

    ctx.moveTo(
        -19,
        -18
    );

    ctx.lineTo(
        -30,
        -27
    );

    ctx.lineTo(
        -17,
        -26
    );

    ctx.lineTo(
        -22,
        -37
    );

    ctx.lineTo(
        -8,
        -28
    );

    ctx.lineTo(
        0,
        -39
    );

    ctx.lineTo(
        8,
        -28
    );

    ctx.lineTo(
        22,
        -34
    );

    ctx.lineTo(
        17,
        -22
    );

    ctx.closePath();

    ctx.fill();


    /* =================================================
       EARS
    ================================================= */

    ctx.fillStyle =
    "#c77b58";


    ctx.beginPath();

    ctx.arc(
        -21,
        -9,
        6,
        0,
        Math.PI*2
    );


    ctx.arc(
        21,
        -9,
        6,
        0,
        Math.PI*2
    );


    ctx.fill();


    /* =================================================
       EYES
    ================================================= */

    ctx.fillStyle =
    "#ffffff";


    ctx.beginPath();

    ctx.ellipse(
        -8,
        -10,
        5,
        4,
        0,
        0,
        Math.PI*2
    );


    ctx.ellipse(
        8,
        -10,
        5,
        4,
        0,
        0,
        Math.PI*2
    );


    ctx.fill();


    ctx.fillStyle =
    "#111";


    ctx.beginPath();

    ctx.arc(
        -8,
        -10,
        2.2,
        0,
        Math.PI*2
    );


    ctx.arc(
        8,
        -10,
        2.2,
        0,
        Math.PI*2
    );


    ctx.fill();


    /* =================================================
       NOSE
    ================================================= */

    ctx.strokeStyle =
    "#9b5d48";

    ctx.lineWidth = 2;


    ctx.beginPath();

    ctx.moveTo(
        0,
        -8
    );

    ctx.lineTo(
        -2,
        0
    );

    ctx.lineTo(
        3,
        1
    );

    ctx.stroke();


    /* =================================================
       SMILE
    ================================================= */

    ctx.strokeStyle =
    "#7f3f35";

    ctx.lineWidth = 2;


    ctx.beginPath();

    ctx.arc(
        0,
        2,
        7,
        .1,
        Math.PI-.1
    );

    ctx.stroke();


    /* =================================================
       SUNGLASSES
    ================================================= */

    ctx.strokeStyle =
    "#111";

    ctx.lineWidth = 3;


    ctx.beginPath();

    ctx.roundRect(
        -18,
        -17,
        15,
        10,
        3
    );


    ctx.roundRect(
        3,
        -17,
        15,
        10,
        3
    );


    ctx.moveTo(
        -3,
        -13
    );

    ctx.lineTo(
        3,
        -13
    );

    ctx.stroke();


    /* =================================================
       WATER SPLASH
    ================================================= */

    ctx.fillStyle =
    "rgba(255,255,255,.75)";


    for(
        let i=0;
        i<4;
        i++
    ){

        ctx.beginPath();

        ctx.arc(
            -40+
            Math.random()*80,
            88+
            Math.random()*10,
            2+
            Math.random()*3,
            0,
            Math.PI*2
        );

        ctx.fill();

    }


    ctx.restore();

}


/* =====================================================
   OBSTACLE
===================================================== */

function createObstacle(){

    obstacles.push({

        x:
        Math.random()*
        (W-70)+35,

        y:-50,

        size:
        25+
        Math.random()*20

    });

}


/* =====================================================
   DRAW OBSTACLE
===================================================== */

function drawObstacle(o){

    ctx.save();


    ctx.translate(
        o.x,
        o.y
    );


    /* ROCK */

    ctx.fillStyle =
    "#333";


    ctx.beginPath();

    ctx.arc(
        0,
        0,
        o.size,
        0,
        Math.PI*2
    );

    ctx.fill();


    /* ROCK LIGHT */

    ctx.fillStyle =
    "#555";


    ctx.beginPath();

    ctx.arc(
        -8,
        -8,
        o.size*.35,
        0,
        Math.PI*2
    );

    ctx.fill();


    ctx.restore();

}


/* =====================================================
   COINS
===================================================== */

function createCoin(){

    coinList.push({

        x:
        Math.random()*
        (W-60)+30,

        y:-30,

        r:12

    });

}


function drawCoin(c){

    ctx.save();


    ctx.shadowBlur =
    15;

    ctx.shadowColor =
    "#ffd60a";


    ctx.fillStyle =
    "#ffd60a";


    ctx.beginPath();

    ctx.arc(
        c.x,
        c.y,
        c.r,
        0,
        Math.PI*2
    );

    ctx.fill();


    ctx.shadowBlur =
    0;


    ctx.strokeStyle =
    "#fff";

    ctx.lineWidth = 2;

    ctx.stroke();


    ctx.fillStyle =
    "#ffffff";

    ctx.font =
    "bold 14px Arial";

    ctx.textAlign =
    "center";


    ctx.fillText(
        "$",
        c.x,
        c.y+5
    );


    ctx.restore();

}


/* =====================================================
   COLLISION
===================================================== */

function playerY(){

    return H*.72 -
    player.height -
    player.y;

}


function collision(
    obstacle
){

    const px =
    player.x;

    const py =
    playerY();


    return (

        px -
        player.width/2
        <
        obstacle.x+
        obstacle.size

        &&

        px+
        player.width/2
        >
        obstacle.x-
        obstacle.size

        &&

        py
        <
        obstacle.y+
        obstacle.size

        &&

        py+
        player.height
        >
        obstacle.y-
        obstacle.size

    );

}


/* =====================================================
   GAME OVER
===================================================== */

function gameOver(){

    if(!running)
        return;


    running = false;


    beep(
        120,
        .3
    );


    document
    .getElementById(
        "finalScore"
    )
    .textContent =
    Math.floor(score);


    document
    .getElementById(
        "gameOver"
    )
    .classList.add(
        "show"
    );

}


/* =====================================================
   UPDATE
===================================================== */

function update(){

    if(!running)
        return;


    /* MOVEMENT */

    if(keys.left){

        player.x -= 7;

    }


    if(keys.right){

        player.x += 7;

    }


    /* BOUNDARY */

    player.x =
    Math.max(
        35,
        Math.min(
            W-35,
            player.x
        )
    );


    /* GRAVITY */

    player.vy += .7;

    player.y -=
    player.vy;


    if(
        player.y <= 0
    ){

        player.y = 0;

        player.vy = 0;

        player.jumping = false;

    }


    /* OBSTACLE SPAWN */

    spawnTimer--;


    if(
        spawnTimer <= 0
    ){

        createObstacle();


        spawnTimer =
        35+
        Math.random()*45;

    }


    /* COIN SPAWN */

    coinTimer--;


    if(
        coinTimer <= 0
    ){

        createCoin();


        coinTimer =
        25+
        Math.random()*35;

    }


    /* MOVE OBSTACLES */

    obstacles.forEach(
        o=>{

            o.y += speed;

        }
    );


    /* MOVE COINS */

    coinList.forEach(
        c=>{

            c.y += speed;

        }
    );


    /* COLLISION */

    obstacles.forEach(
        o=>{

            if(
                collision(o)
            ){

                gameOver();

            }

        }
    );


    /* COIN COLLECTION */

    coinList =
    coinList.filter(
        c=>{

            const dx =
            player.x-c.x;


            const dy =
            playerY()-c.y;


            const distance =
            Math.sqrt(
                dx*dx+
                dy*dy
            );


            if(
                distance < 55
            ){

                coins++;

                score += 50;


                document
                .getElementById(
                    "coins"
                )
                .textContent =
                coins;


                beep(
                    900,
                    .08
                );


                return false;

            }


            return (
                c.y < H+50
            );

        }
    );


    /* REMOVE OLD */

    obstacles =
    obstacles.filter(
        o=>
        o.y < H+100
    );


    /* SCORE */

    score += .15;


    /* SPEED */

    speed += .0005;


    document
    .getElementById(
        "score"
    )
    .textContent =
    Math.floor(score);

}


/* =====================================================
   DRAW
===================================================== */

function draw(){

    drawOcean();

    drawHorizon();


    obstacles.forEach(
        drawObstacle
    );


    coinList.forEach(
        drawCoin
    );


    drawPlayer();

}


/* =====================================================
   GAME LOOP
===================================================== */

function loop(){

    update();

    draw();


    requestAnimationFrame(
        loop
    );

}


loop();


/* =====================================================
   RESTART
===================================================== */

document
.getElementById(
    "restart"
)
.addEventListener(
    "click",
    ()=>{

        location.reload();

    }
);


/* =====================================================
   START AUDIO ON FIRST TOUCH
===================================================== */

document.addEventListener(
    "pointerdown",
    ()=>{

        if(!audioCtx){

            try{

                audioCtx =
                new (
                    window.AudioContext ||
                    window.webkitAudioContext
                )();

            }
            catch(e){}

        }

    },
    {
        once:true
    }
);

</script>

</body>
</html>
