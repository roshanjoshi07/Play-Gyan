/* =====================================================
   SHUFFLE
===================================================== */

function shuffle(array){
  let a=[...array];

  for(let i=a.length-1;i>0;i--){
    let j=Math.floor(Math.random()*(i+1));
    [a[i],a[j]]=[a[j],a[i]];
  }

  return a;
}


/* =====================================================
   QUESTION BANK
===================================================== */

function displayBank(){

  const search=document
    .getElementById("search")
    .value
    .toLowerCase();

  let html="";

  questions.forEach((q,index)=>{

    if(
      !q[1].toLowerCase().includes(search) &&
      !q[2].toLowerCase().includes(search)
    ){
      return;
    }

    html+=`
      <div class="card">
        <div class="category">${q[0]}</div>

        <div class="question">
          ${index+1}. ${q[1]}
        </div>

        <div class="answer">
          ✅ Answer: ${q[2]}
        </div>
      </div>
    `;
  });

  document.getElementById("bankList").innerHTML=html;
}


/* =====================================================
   GAME VARIABLES
===================================================== */

let gameQuestions=[];
let currentQuestion=0;
let score=0;
let lives=3;
let answered=false;


/* =====================================================
   START GAME
===================================================== */

function startGame(){

  gameQuestions=shuffle(questions);
  currentQuestion=0;
  score=0;
  lives=3;
  answered=false;

  document.getElementById("bank").classList.add("hidden");
  document.getElementById("result").classList.add("hidden");
  document.getElementById("game").classList.remove("hidden");

  loadQuestion();

  window.scrollTo({
    top:0,
    behavior:"smooth"
  });
}


/* =====================================================
   CREATE OPTIONS
===================================================== */

function createOptions(correct){

  let wrongAnswers=questions
    .map(q=>q[2])
    .filter(a=>a!==correct);

  wrongAnswers=[...new Set(wrongAnswers)];

  wrongAnswers=shuffle(wrongAnswers).slice(0,3);

  return shuffle([
    correct,
    ...wrongAnswers
  ]);
}


/* =====================================================
   LOAD QUESTION
===================================================== */

function loadQuestion(){

  answered=false;

  const q=gameQuestions[currentQuestion];

  document.getElementById("questionNumber")
    .textContent=currentQuestion+1;

  document.getElementById("score")
    .textContent=score;

  document.getElementById("lives")
    .textContent=lives;

  document.getElementById("progressBar")
    .style.width=
    ((currentQuestion/questions.length)*100)+"%";

  document.getElementById("gameQuestion")
    .textContent=q[1];

  const optionsBox=document.getElementById("options");

  optionsBox.innerHTML="";

  const options=createOptions(q[2]);

  options.forEach(answer=>{

    const button=document.createElement("button");

    button.className="option";
    button.textContent=answer;

    button.onclick=()=>{
      checkAnswer(button,answer,q[2]);
    };

    optionsBox.appendChild(button);
  });

  document.getElementById("nextButton").disabled=true;
}


/* =====================================================
   CHECK ANSWER
===================================================== */

function checkAnswer(button,selected,correct){

  if(answered)return;

  answered=true;

  const buttons=
    document.querySelectorAll(".option");

  buttons.forEach(b=>{
    b.disabled=true;
  });

  if(selected===correct){

    button.classList.add("correct");

    score++;

  }else{

    button.classList.add("wrong");

    lives--;

    buttons.forEach(b=>{

      if(b.textContent===correct){
        b.classList.add("correct");
      }

    });
  }

  document.getElementById("score")
    .textContent=score;

  document.getElementById("lives")
    .textContent=lives;

  if(lives<=0){

    setTimeout(gameOver,600);

  }else{

    document.getElementById("nextButton")
      .disabled=false;
  }
}


/* =====================================================
   NEXT QUESTION
===================================================== */

function nextQuestion(){

  if(!answered)return;

  currentQuestion++;

  if(currentQuestion>=gameQuestions.length){

    finishGame();

  }else{

    loadQuestion();
  }
}


/* =====================================================
   GAME OVER
===================================================== */

function gameOver(){

  document.getElementById("game")
    .classList.add("hidden");

  document.getElementById("result")
    .classList.remove("hidden");

  document.getElementById("resultScore")
    .textContent=
    `💔 Game Over — ${score}/${questions.length}`;

  document.getElementById("resultMessage")
    .textContent=
    "तपाईंका 3 वटा Life सकिए। फेरि खेल्न सक्नुहुन्छ।";
}


/* =====================================================
   FINISH
===================================================== */

function finishGame(){

  document.getElementById("game")
    .classList.add("hidden");

  document.getElementById("result")
    .classList.remove("hidden");

  const percentage=
    Math.round((score/questions.length)*100);

  document.getElementById("resultScore")
    .textContent=
    `🏆 Final Score: ${score}/${questions.length}`;

  document.getElementById("resultMessage")
    .textContent=
    `📊 Your Percentage: ${percentage}%`;
}


/* =====================================================
   SHOW QUESTION BANK
===================================================== */

function showBank(){

  document.getElementById("game")
    .classList.add("hidden");

  document.getElementById("result")
    .classList.add("hidden");

  document.getElementById("bank")
    .classList.remove("hidden");

  window.scrollTo({
    top:0,
    behavior:"smooth"
  });
}


/* =====================================================
   INITIAL LOAD
===================================================== */

displayBank();

</script>

</body>
</html>