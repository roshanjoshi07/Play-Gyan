  color:#172033;
}

header{
  text-align:center;
  color:white;
  padding:30px 15px 20px;
}

header h1{
  font-size:clamp(30px,7vw,55px);
}

header p{
  margin-top:8px;
  opacity:.9;
}

.nav{
  display:flex;
  justify-content:center;
  flex-wrap:wrap;
  gap:10px;
  margin-top:20px;
}

.nav button{
  border:0;
  border-radius:30px;
  padding:13px 22px;
  cursor:pointer;
  font-weight:bold;
  font-size:15px;
}

.container{
  width:min(1050px,94%);
  margin:auto;
}

.panel{
  background:white;
  border-radius:24px;
  padding:25px;
  margin-bottom:30px;
  box-shadow:0 20px 60px #0006;
}

.hidden{
  display:none;
}

.search{
  width:100%;
  padding:15px;
  border:2px solid #ddd;
  border-radius:14px;
  margin:18px 0;
  font-size:16px;
}

.card{
  padding:18px;
  margin:12px 0;
  border-radius:15px;
  background:#f8fafc;
  border-left:6px solid #1479c9;
}

.category{
  display:inline-block;
  background:#e0f2fe;
  color:#075985;
  padding:5px 10px;
  border-radius:20px;
  font-size:13px;
  font-weight:bold;
  margin-bottom:8px;
}

.question{
  font-size:18px;
  font-weight:bold;
  line-height:1.55;
}

.answer{
  margin-top:10px;
  padding:10px;
  border-radius:10px;
  background:#dcfce7;
  color:#166534;
  font-weight:bold;
}

.stats{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:12px;
}

.stat{
  background:#eff6ff;
  padding:15px;
  text-align:center;
  border-radius:15px;
  font-weight:bold;
}

.progress{
  width:100%;
  height:10px;
  background:#e5e7eb;
  border-radius:20px;
  margin:18px 0;
  overflow:hidden;
}

.progressBar{
  height:100%;
  width:0;
  background:#16a34a;
  transition:.3s;
}

.gameQuestion{
  font-size:25px;
  font-weight:bold;
  line-height:1.5;
  margin:25px 0;
}

.options{
  display:grid;
  gap:12px;
}

.option{
  width:100%;
  padding:16px;
  border:2px solid #dbe4ee;
  border-radius:14px;
  background:white;
  cursor:pointer;
  text-align:left;
  font-size:17px;
  transition:.2s;
}

.option:hover{
  background:#eff6ff;
  transform:translateY(-2px);
}

.correct{
  background:#bbf7d0 !important;
  border-color:#16a34a !important;
}

.wrong{
  background:#fecaca !important;
  border-color:#dc2626 !important;
}

.next,
.restart{
  width:100%;
  border:0;
  border-radius:14px;
  padding:15px;
  margin-top:18px;
  background:#0879c9;
  color:white;
  font-size:17px;
  font-weight:bold;
  cursor:pointer;
}

.next:disabled{
  opacity:.45;
  cursor:not-allowed;
}

.result{
  text-align:center;
}

.result h2{
  font-size:36px;
  margin-bottom:15px;
}

.footer{
  text-align:center;
  color:white;
  padding:25px;
}

@media(max-width:600px){
  .panel{
    padding:17px;
  }

  .stats{
    grid-template-columns:1fr;
  }

  .gameQuestion{
    font-size:21px;
  }

  .option{
    font-size:16px;
  }
}
</style>
</head>

