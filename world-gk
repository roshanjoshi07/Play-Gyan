<!DOCTYPE html>
<html lang="ne">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>🌍 World GK — 500 Questions</title>

<style>
*{box-sizing:border-box}

body{
 margin:0;
 font-family:Arial,"Noto Sans Devanagari",sans-serif;
 background:linear-gradient(135deg,#061b38,#075985,#0891b2);
 color:#222;
}

header{
 color:white;
 text-align:center;
 padding:35px 15px;
}

header h1{
 font-size:clamp(35px,8vw,60px);
 margin:0;
}

header p{
 font-size:18px;
}

.nav{
 display:flex;
 justify-content:center;
 flex-wrap:wrap;
 gap:10px;
 margin:20px 0;
}

.nav button{
 padding:13px 20px;
 border:0;
 border-radius:12px;
 cursor:pointer;
 font-weight:bold;
 font-size:16px;
}

.container{
 width:min(1100px,94%);
 margin:auto;
}

.panel{
 background:white;
 border-radius:22px;
 padding:25px;
 margin-bottom:30px;
 box-shadow:0 15px 50px #0004;
}

.hidden{
 display:none!important;
}

/* QUESTION BANK */

.search{
 width:100%;
 padding:14px;
 border:2px solid #ddd;
 border-radius:12px;
 font-size:16px;
 margin-bottom:20px;
}

.question-card{
 padding:18px;
 margin:15px 0;
 background:#f7fbff;
 border-left:6px solid #087fbd;
 border-radius:12px;
}

.question-number{
 font-weight:bold;
 color:#087fbd;
}

.question-text{
 font-size:18px;
 font-weight:bold;
 margin:8px 0;
}

.answer{
 padding:10px 14px;
 background:#d9fbe5;
 color:#087b38;
 border-radius:10px;
 font-weight:bold;
}

/* GAME */

.stats{
 display:flex;
 justify-content:space-between;
 flex-wrap:wrap;
 gap:10px;
}

.stat{
 padding:10px 15px;
 background:#edf5ff;
 border-radius:20px;
 font-weight:bold;
}

.progress{
 height:10px;
 background:#ddd;
 border-radius:20px;
 overflow:hidden;
 margin:20px 0;
}

.progress-bar{
 height:100%;
 width:0%;
 background:#087fbd;
 transition:.3s;
}

.game-question{
 font-size:25px;
 font-weight:bold;
 line-height:1.5;
 margin:30px 0;
}

.options{
 display:grid;
 gap:12px;
}

.option{
 padding:16px;
 border:2px solid #dce5ee;
 background:#fff;
 border-radius:14px;
 cursor:pointer;
 text-align:left;
 font-size:17px;
 transition:.2s;
}

.option:hover{
 background:#eef8ff;
 transform:translateX(4px);
}

.correct{
 background:#c9f7d5!important;
 border-color:#16a34a!important;
}

.wrong{
 background:#ffd2d2!important;
 border-color:#dc2626!important;
}

.next{
 width:100%;
 padding:15px;
 margin-top:20px;
 border:0;
 border-radius:14px;
 background:#087fbd;
 color:white;
 font-size:18px;
 cursor:pointer;
}

.next:disabled{
 opacity:.5;
 cursor:not-allowed;
}

.result{
 text-align:center;
}

.restart{
 padding:14px 25px;
 border:0;
 border-radius:12px;
 background:#16a34a;
 color:white;
 font-size:17px;
 cursor:pointer;
}

@media(max-width:600px){

 .panel{
  padding:16px;
 }

 .game-question{
  font-size:20px;
 }

 .option{
  font-size:16px;
 }

}
</style>
</head>

<body>

<header>

<h1>🌍 WORLD GK</h1>

<p>
500 Questions • Countries • Capitals • Currencies • Famous Places
</p>

<div class="nav">

<button onclick="showBank()">
📚 Question Bank
</button>

<button onclick="showGame()">
🎮 Play Quiz
</button>

</div>

</header>


<div class="container">

<!-- ===================================
     QUESTION BANK
=================================== -->

<section id="bank" class="panel">

<h2>📚 1–500 World GK Questions</h2>

<p>
यहाँ सबै प्रश्न र तिनका सही उत्तरहरू देखिन्छन्।
</p>

<input
 id="search"
 class="search"
 placeholder="🔍 प्रश्न वा उत्तर खोज्नुहोस्..."
 oninput="renderBank()"
>

<div id="questionBank"></div>

</section>


<!-- ===================================
     GAME
=================================== -->

<section id="game" class="panel hidden">

<div class="stats">

<div class="stat">
📌 Question:
<span id="qNo">1</span>/500
</div>

<div class="stat">
🏆 Score:
<span id="score">0</span>
</div>

<div class="stat">
❤️ Life:
<span id="life">3</span>
</div>

</div>

<div class="progress">
<div id="progressBar" class="progress-bar"></div>
</div>

<div
 id="gameQuestion"
 class="game-question">
</div>

<div
 id="options"
 class="options">
</div>

<button
 id="nextButton"
 class="next"
 onclick="nextQuestion()"
 disabled>

अर्को प्रश्न ➡️

</button>

</section>


<!-- RESULT -->

<section
id="result"
class="panel result hidden">

<h2>🎉 Quiz समाप्त!</h2>

<h3 id="resultScore"></h3>

<p id="resultPercent"></p>

<button
class="restart"
onclick="restartGame()">

🔄 फेरि खेल्नुहोस्

</button>

</section>

</div>


