["हवाना पुरानो शहर","क्युबा"],
["केप टाउन","दक्षिण अफ्रिका"],
["टेबल माउन्टेन","दक्षिण अफ्रिका"],
["सेरेन्गेटी राष्ट्रिय निकुञ्ज","तान्जानिया"],
["ओकाभाङ्गो डेल्टा","बोत्सवाना"],
["मेडागास्करका वर्षावन","मेडागास्कर"]

];


/* ==========================================
   GENERATE EXACTLY 500 QUESTIONS
========================================== */

let questions=[];


/* 4 questions per country */

countries.forEach(c=>{

 let country=c[0];
 let capital=c[1];
 let currency=c[2];
 let continent=c[3];

 questions.push({
  q:`${country} को राजधानी कुन हो?`,
  a:capital
 });

 questions.push({
  q:`${country} को मुद्रा कुन हो?`,
  a:currency
 });

 questions.push({
  q:`${capital} कुन देशको राजधानी हो?`,
  a:country
 });

 questions.push({
  q:`${country} कुन महादेशमा पर्छ?`,
  a:continent
 });

});


/*
50 places × 2 = 100
100 countries × 4 = 400
TOTAL = 500
*/

places.forEach(p=>{

 questions.push({
  q:`${p[0]} कुन देश/देशहरूमा अवस्थित छ?`,
  a:p[1]
 });

 questions.push({
  q:`${p[1]} सँग सम्बन्धित प्रसिद्ध स्थान कुन हो?`,
  a:p[0]
 });

});


/* Keep exactly 500 */

questions=questions.slice(0,500);


/* ==========================================
   SHUFFLE
========================================== */

function shuffle(arr){

 for(let i=arr.length-1;i>0;i--){

  let j=Math.floor(
   Math.random()*(i+1)
  );

  [arr[i],arr[j]]=
  [arr[j],arr[i]];

 }

 return arr;
}


/* ==========================================
   QUESTION BANK
========================================== */

function renderBank(){

 let search=
 document.getElementById("search")
 .value
 .toLowerCase();

 let box=
 document.getElementById("questionBank");

 box.innerHTML="";

 questions.forEach((item,index)=>{

  let text=
  (item.q+" "+item.a)
  .toLowerCase();

  if(!text.includes(search))return;

  let div=
  document.createElement("div");

  div.className="question-card";

  div.innerHTML=`

  <div class="question-number">
  प्रश्न ${index+1}
  </div>

  <div class="question-text">
  ${item.q}
  </div>

  <div class="answer">
  ✅ सही Answer: ${item.a}
  </div>

  `;

  box.appendChild(div);

 });

}


/* ==========================================
   SHOW / HIDE
========================================== */

function showBank(){

 document.getElementById("bank")
 .classList.remove("hidden");

 document.getElementById("game")
 .classList.add("hidden");

 document.getElementById("result")
 .classList.add("hidden");

 window.scrollTo(0,0);

}


function showGame(){

 document.getElementById("bank")
 .classList.add("hidden");

 document.getElementById("game")
 .classList.remove("hidden");

 document.getElementById("result")
 .classList.add("hidden");

 startGame();

 window.scrollTo(0,0);

}


/* ==========================================
   GAME
========================================== */

let gameQuestions=[];
let current=0;
let score=0;
let lives=3;
let answered=false;


function startGame(){

 gameQuestions=
 shuffle([...questions]);

 current=0;
 score=0;
 lives=3;

 loadQuestion();

}


function makeOptions(correct){

 let values=
 questions
 .map(x=>x.a)
 .filter(x=>x!==correct);

 values=shuffle([...new Set(values)]);

 let options=
 values.slice(0,3);

 options.push(correct);

 return shuffle(options);

}


function loadQuestion(){

 answered=false;

 let item=
 gameQuestions[current];

 document.getElementById("qNo")
 .textContent=current+1;

 document.getElementById("score")
 .textContent=score;

 document.getElementById("life")
 .textContent=lives;

 document.getElementById("gameQuestion")
 .textContent=item.q;

 document.getElementById("progressBar")
 .style.width=
 ((current/500)*100)+"%";

 let box=
 document.getElementById("options");

 box.innerHTML="";

 let options=
 makeOptions(item.a);

 options.forEach(option=>{

  let button=
  document.createElement("button");

  button.className="option";

  button.textContent=option;

  button.onclick=()=>{

   checkAnswer(
    button,
    option,
    item.a
   );

  };

  box.appendChild(button);

 });

 document.getElementById("nextButton")
 .disabled=true;

}


/* ==========================================
   CHECK ANSWER
========================================== */

function checkAnswer(button,selected,correct){

 if(answered)return;

 answered=true;

 document
 .querySelectorAll(".option")
 .forEach(x=>x.disabled=true);

 if(selected===correct){

  button.classList.add("correct");

  score++;

 }else{

  button.classList.add("wrong");

  lives--;

  document
  .querySelectorAll(".option")
  .forEach(x=>{

   if(x.textContent===correct){

    x.classList.add("correct");

   }

  });

 }

 document.getElementById("score")
 .textContent=score;

 document.getElementById("life")
 .textContent=lives;

 if(lives<=0){

  setTimeout(gameOver,500);

 }else{

  document.getElementById("nextButton")
  .disabled=false;

 }

}


/* ==========================================
   NEXT
========================================== */

function nextQuestion(){

 if(!answered)return;

 current++;

 if(current>=500){

  finishGame();

 }else{

  loadQuestion();

 }

}


/* ==========================================
   FINISH
========================================== */

function finishGame(){

 document.getElementById("game")
 .classList.add("hidden");

 document.getElementById("result")
 .classList.remove("hidden");

 let percent=
 Math.round(score/500*100);

 document.getElementById("resultScore")
 .textContent=
 `🏆 Score: ${score}/500`;

 document.getElementById("resultPercent")
 .textContent=
 `📊 Percentage: ${percent}%`;

}


/* ==========================================
   GAME OVER
========================================== */

function gameOver(){

 document.getElementById("game")
 .classList.add("hidden");

 document.getElementById("result")
 .classList.remove("hidden");

 document.getElementById("resultScore")
 .textContent=
 `💔 Game Over — Score: ${score}`;

 document.getElementById("resultPercent")
 .textContent=
 "❤️ तपाईंका 3 Life सकिए।";

}


/* ==========================================
   RESTART
========================================== */

function restartGame(){

 document.getElementById("result")
 .classList.add("hidden");

 document.getElementById("game")
 .classList.remove("hidden");

 startGame();

}


/* START */

renderBank();

</script>

