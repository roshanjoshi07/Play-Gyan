<!DOCTYPE html>
<html lang="ne">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>World GK - विश्व सामान्य ज्ञान</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:"Noto Sans Devanagari",Arial,sans-serif;
    background:
        radial-gradient(circle at top left,#174a72 0%,transparent 35%),
        radial-gradient(circle at bottom right,#32165c 0%,transparent 35%),
        linear-gradient(135deg,#06121f,#0a1d30,#07111d);
    color:#f4f8ff;
    min-height:100vh;
}

/* HEADER */

.header{
    position:relative;
    overflow:hidden;
    text-align:center;
    padding:55px 20px 45px;
    background:rgba(3,12,23,.65);
    border-bottom:1px solid rgba(255,255,255,.12);
}

.header::before{
    content:"🌍";
    position:absolute;
    font-size:180px;
    opacity:.06;
    right:5%;
    top:-35px;
}

.header::after{
    content:"";
    position:absolute;
    width:180px;
    height:180px;
    border:1px solid rgba(83,190,255,.15);
    border-radius:50%;
    left:-70px;
    bottom:-100px;
}

.globe{
    font-size:55px;
    margin-bottom:12px;
    filter:drop-shadow(0 0 18px rgba(65,190,255,.5));
}

.header h1{
    font-size:34px;
    margin-bottom:10px;
    letter-spacing:.5px;
}

.header p{
    color:#a9c1d5;
    font-size:16px;
}

/* MAIN */

.container{
    width:94%;
    max-width:1050px;
    margin:35px auto;
}

/* CATEGORY TITLE */

.section-title{
    display:flex;
    align-items:center;
    gap:12px;
    margin:30px 0 18px;
}

.section-title span{
    width:5px;
    height:30px;
    border-radius:5px;
    background:#39bdf8;
    box-shadow:0 0 12px #39bdf8;
}

.section-title h2{
    font-size:22px;
}

/* QUESTION CARD */

.qa-card{
    position:relative;
    background:
        linear-gradient(
            145deg,
            rgba(24,53,78,.92),
            rgba(8,24,40,.96)
        );
    border:1px solid rgba(120,200,255,.13);
    border-radius:18px;
    padding:24px 25px;
    margin-bottom:18px;
    box-shadow:
        0 12px 35px rgba(0,0,0,.25),
        inset 0 1px 0 rgba(255,255,255,.04);
    transition:.25s ease;
}

.qa-card:hover{
    transform:translateY(-3px);
    border-color:rgba(80,190,255,.35);
    box-shadow:
        0 16px 40px rgba(0,0,0,.35),
        0 0 25px rgba(30,150,220,.08);
}

.question{
    color:#ffffff;
    font-size:19px;
    font-weight:700;
    line-height:1.7;
    margin-bottom:15px;
}

.question-number{
    color:#42c5ff;
    margin-right:5px;
}

.answer-box{
    border-top:1px solid rgba(255,255,255,.09);
    padding-top:14px;
}

.answer-label{
    color:#62d4ff;
    font-size:14px;
    font-weight:bold;
    margin-bottom:5px;
}

.answer{
    color:#d6e5ef;
    font-size:17px;
    line-height:1.75;
}

/* SEARCH */

.search-box{
    margin-bottom:30px;
}

.search-box input{
    width:100%;
    padding:16px 20px;
    border-radius:13px;
    border:1px solid rgba(120,200,255,.15);
    outline:none;
    background:rgba(8,25,42,.85);
    color:white;
    font-size:16px;
}

.search-box input::placeholder{
    color:#7892a7;
}

.search-box input:focus{
    border-color:#39bdf8;
    box-shadow:0 0 18px rgba(57,189,248,.12);
}

/* FOOTER */

.footer{
    text-align:center;
    padding:35px 20px;
    margin-top:50px;
    color:#728ba0;
    border-top:1px solid rgba(255,255,255,.08);
}

/* MOBILE */

@media(max-width:600px){

    .header{
        padding:40px 15px;
    }

    .header h1{
        font-size:26px;
    }

    .globe{
        font-size:45px;
    }

    .container{
        width:92%;
    }

    .qa-card{
        padding:19px;
        border-radius:15px;
    }

    .question{
        font-size:17px;
    }

    .answer{
        font-size:16px;
    }
}
</style>
</head>

<body>

<header class="header">

    <div class="globe">🌍</div>

    <h1>विश्व सामान्य ज्ञान</h1>

    <p>
        महत्वपूर्ण विश्वस्तरीय प्रश्न तथा तिनका उत्तर
    </p>

</header>


<main class="container">

    <!-- SEARCH -->

    <div class="search-box">
        <input
            type="text"
            id="search"
            placeholder="प्रश्न वा उत्तर खोज्नुहोस्..."
            oninput="searchQuestions()"
        >
    </div>


    <!-- INTERNATIONAL ORGANIZATIONS -->

    <div class="section-title">
        <span></span>
        <h2>अन्तर्राष्ट्रिय संगठनहरू</h2>
    </div>


    <div id="questions">


        <div class="qa-card">

            <div class="question">
                <span class="question-number">प्रश्न १:</span>
                संयुक्त राष्ट्रसंघमा हाल कति सदस्य राष्ट्र छन्?
            </div>

            <div class="answer-box">

                <div class="answer-label">
                    उत्तर
                </div>

                <div class="answer">
                    संयुक्त राष्ट्रसंघमा हाल १९३ सदस्य राष्ट्र छन्।
                </div>

            </div>

        </div>


        <div class="qa-card">

            <div class="question">
                <span class="question-number">प्रश्न २:</span>
                संयुक्त राष्ट्रसंघको मुख्यालय कहाँ रहेको छ?
            </div>

            <div class="answer-box">

                <div class="answer-label">
                    उत्तर
                </div>

                <div class="answer">
                    संयुक्त राष्ट्रसंघको मुख्यालय अमेरिकाको न्यूयोर्क शहरमा रहेको छ।
                </div>

            </div>

        </div>


        <div class="qa-card">

            <div class="question">
                <span class="question-number">प्रश्न ३:</span>
                संयुक्त राष्ट्र सुरक्षा परिषद्मा जम्मा कति सदस्य हुन्छन्?
            </div>

            <div class="answer-box">

                <div class="answer-label">
                    उत्तर
                </div>

                <div class="answer">
                    संयुक्त राष्ट्र सुरक्षा परिषद्मा जम्मा १५ सदस्य हुन्छन्।
                </div>

            </div>

        </div>


        <div class="qa-card">

            <div class="question">
                <span class="question-number">प्रश्न ४:</span>
                संयुक्त राष्ट्र सुरक्षा परिषद्का स्थायी सदस्य राष्ट्रहरू कुन-कुन हुन्?
            </div>

            <div class="answer-box">

                <div class="answer-label">
                    उत्तर
                </div>

                <div class="answer">
                    चीन, फ्रान्स, रुस, बेलायत र संयुक्त राज्य अमेरिका सुरक्षा परिषद्का पाँच स्थायी सदस्य हुन्।
                </div>

            </div>

        </div>


        <div class="qa-card">

            <div class="question">
                <span class="question-number">प्रश्न ५:</span>
                विश्व स्वास्थ्य संगठनको अंग्रेजी संक्षिप्त नाम के हो?
            </div>

            <div class="answer-box">

                <div class="answer-label">
                    उत्तर
                </div>

                <div class="answer">
                    WHO अर्थात् World Health Organization हो।
                </div>

            </div>

        </div>


        <!-- FINANCIAL INSTITUTIONS -->

        <div class="section-title">
            <span></span>
            <h2>विश्वका वित्तीय संस्था</h2>
        </div>


        <div class="qa-card">

            <div class="question">
                <span class="question-number">प्रश्न ६:</span>
                अन्तर्राष्ट्रिय मुद्रा कोषको अंग्रेजी संक्षिप्त नाम के हो?
            </div>

            <div class="answer-box">

                <div class="answer-label">
                    उत्तर
                </div>

                <div class="answer">
                    IMF अर्थात् International Monetary Fund हो।
                </div>

            </div>

        </div>


        <div class="qa-card">

            <div class="question">
                <span class="question-number">प्रश्न ७:</span>
                विश्व बैंकको मुख्यालय कहाँ रहेको छ?
            </div>

            <div class="answer-box">

                <div class="answer-label">
                    उत्तर
                </div>

                <div class="answer">
                    विश्व बैंकको मुख्यालय अमेरिकाको वासिङ्टन डी.सी.मा रहेको छ।
                </div>

            </div>

        </div>


        <!-- WORLD GEOGRAPHY -->

        <div class="section-title">
            <span></span>
            <h2>विश्व भूगोल</h2>
        </div>


        <div class="qa-card">

            <div class="question">
                <span class="question-number">प्रश्न ८:</span>
                क्षेत्रफलका आधारमा विश्वको सबैभन्दा ठूलो महादेश कुन हो?
            </div>

            <div class="answer-box">

                <div class="answer-label">
                    उत्तर
                </div>

                <div class="answer">
                    एसिया विश्वको सबैभन्दा ठूलो महादेश हो।
                </div>

            </div>

        </div>


        <div class="qa-card">

            <div class="question">
                <span class="question-number">प्रश्न ९:</span>
                विश्वको सबैभन्दा ठूलो महासागर कुन हो?
            </div>

            <div class="answer-box">

                <div class="answer-label">
                    उत्तर
                </div>

                <div class="answer">
                    प्रशान्त महासागर विश्वको सबैभन्दा ठूलो महासागर हो।
                </div>

            </div>

        </div>


        <div class="qa-card">

            <div class="question">
                <span class="question-number">प्रश्न १०:</span>
                समुद्री सतहबाट विश्वको सबैभन्दा अग्लो पर्वत कुन हो?
            </div>

            <div class="answer-box">

                <div class="answer-label">
                    उत्तर
                </div>

                <div class="answer">
                    सगरमाथा समुद्री सतहबाट विश्वको सबैभन्दा अग्लो पर्वत हो।
                </div>

            </div>

        </div>


        <!-- CLIMATE -->

        <div class="section-title">
            <span></span>
            <h2>जलवायु तथा वातावरण</h2>
        </div>


        <div class="qa-card">

            <div class="question">
                <span class="question-number">प्रश्न ११:</span>
                विश्वव्यापी तापक्रम वृद्धि भन्नाले के बुझिन्छ?
            </div>

            <div class="answer-box">

                <div class="answer-label">
                    उत्तर
                </div>

                <div class="answer">
                    पृथ्वीको औसत सतह तापक्रम लामो समयसम्म बढ्दै जाने प्रक्रियालाई विश्वव्यापी तापक्रम वृद्धि भनिन्छ।
                </div>

            </div>

        </div>


        <div class="qa-card">

            <div class="question">
                <span class="question-number">प्रश्न १२:</span>
                पेरिस सम्झौता मुख्य रूपमा कुन विषयसँग सम्बन्धित छ?
            </div>

            <div class="answer-box">

                <div class="answer-label">
                    उत्तर
                </div>

                <div class="answer">
                    पेरिस सम्झौता मुख्य रूपमा जलवायु परिवर्तन तथा विश्वव्यापी तापक्रम वृद्धिसँग सम्बन्धित अन्तर्राष्ट्रिय सम्झौता हो।
                </div>

            </div>

        </div>


        <!-- TECHNOLOGY -->

        <div class="section-title">
            <span></span>
            <h2>विश्व प्रविधि</h2>
        </div>


        <div class="qa-card">

            <div class="question">
                <span class="question-number">प्रश्न १३:</span>
                कृत्रिम बुद्धिमत्ता भन्नाले के बुझिन्छ?
            </div>

            <div class="answer-box">

                <div class="answer-label">
                    उत्तर
                </div>

                <div class="answer">
                    कम्प्युटर वा मेसिनलाई मानवजस्तै सिक्न, तर्क गर्न, समस्या समाधान गर्न तथा निर्णय लिन सक्षम बनाउने प्रविधिलाई कृत्रिम बुद्धिमत्ता भनिन्छ।
                </div>

            </div>

        </div>


        <div class="qa-card">

            <div class="question">
                <span class="question-number">प्रश्न १४:</span>
                IoT को पूरा रूप के हो?
            </div>

            <div class="answer-box">

                <div class="answer-label">
                    उत्तर
                </div>

                <div class="answer">
                    IoT को पूरा रूप Internet of Things हो।
                </div>

            </div>

        </div>


        <!-- ECONOMICS -->

        <div class="section-title">
            <span></span>
            <h2>विश्व अर्थतन्त्र</h2>
        </div>


        <div class="qa-card">

            <div class="question">
                <span class="question-number">प्रश्न १५:</span>
                GDP को पूरा रूप के हो?
            </div>

            <div class="answer-box">

                <div class="answer-label">
                    उत्तर
                </div>

                <div class="answer">
                    GDP को पूरा रूप Gross Domestic Product अर्थात् कुल गार्हस्थ्य उत्पादन हो।
                </div>

            </div>

        </div>


        <div class="qa-card">

            <div class="question">
                <span class="question-number">प्रश्न १६:</span>
                मुद्रास्फीति भन्नाले के बुझिन्छ?
            </div>

            <div class="answer-box">

                <div class="answer-label">
                    उत्तर
                </div>

                <div class="answer">
                    अर्थतन्त्रमा वस्तु तथा सेवाको सामान्य मूल्यस्तर निरन्तर बढ्दै जाने अवस्थालाई मुद्रास्फीति भनिन्छ।
                </div>

            </div>

        </div>


        <!-- INTERNATIONAL LAW -->

        <div class="section-title">
            <span></span>
            <h2>अन्तर्राष्ट्रिय कानुन</h2>
        </div>


        <div class="qa-card">

            <div class="question">
                <span class="question-number">प्रश्न १७:</span>
                अन्तर्राष्ट्रिय न्यायालय कहाँ अवस्थित छ?
            </div>

            <div class="answer-box">

                <div class="answer-label">
                    उत्तर
                </div>

                <div class="answer">
                    अन्तर्राष्ट्रिय न्यायालय नेदरल्यान्ड्सको हेग शहरमा अवस्थित छ।
                </div>

            </div>

        </div>


        <!-- NOBEL -->

        <div class="section-title">
            <span></span>
            <h2>नोबेल पुरस्कार तथा अन्तर्राष्ट्रिय पुरस्कार</h2>
        </div>


        <div class="qa-card">

            <div class="question">
                <span class="question-number">प्रश्न १८:</span>
                नोबेल पुरस्कारको स्थापना कसले गरेका हुन्?
            </div>

            <div class="answer-box">

                <div class="answer-label">
                    उत्तर
                </div>

                <div class="answer">
                    नोबेल पुरस्कारको स्थापना स्विडेनी वैज्ञानिक तथा आविष्कारक अल्फ्रेड नोबेलले गरेका हुन्।
                </div>

            </div>

        </div>


        <!-- HISTORY -->

        <div class="section-title">
            <span></span>
            <h2>विश्व इतिहास</h2>
        </div>


        <div class="qa-card">

            <div class="question">
                <span class="question-number">प्रश्न १९:</span>
                संयुक्त राष्ट्रसंघको स्थापना कहिले भएको हो?
            </div>

            <div class="answer-box">

                <div class="answer-label">
                    उत्तर
                </div>

                <div class="answer">
                    संयुक्त राष्ट्रसंघको स्थापना २४ अक्टोबर १९४५ मा भएको हो।
                </div>

            </div>

        </div>


        <div class="qa-card">

            <div class="question">
                <span class="question-number">प्रश्न २०:</span>
                दोस्रो विश्वयुद्ध कहिले समाप्त भएको थियो?
            </div>

            <div class="answer-box">

                <div class="answer-label">
                    उत्तर
                </div>

                <div class="answer">
                    दोस्रो विश्वयुद्ध सन् १९४५ मा समाप्त भएको थियो।
                </div>

            </div>

        </div>


    </div>

</main>


<footer class="footer">
    🌍 World GK • प्रश्न तथा उत्तर अध्ययन सामग्री
</footer>


<script>

function searchQuestions(){

    const input =
        document.getElementById("search")
        .value
        .toLowerCase();

    const cards =
        document.querySelectorAll(".qa-card");

    cards.forEach(card=>{

        const text =
            card.innerText.toLowerCase();

        if(text.includes(input)){
            card.style.display="";
        }else{
            card.style.display="none";
        }

    });
}

</script>

</body>
</html>
